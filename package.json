{
  "name": "woittola-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build",
    "test:translation-e2e": "node scripts/translation-e2e.mjs",
    "test:product-slug-e2e": "node scripts/product-slug-e2e.mjs",
    "test:references-e2e": "node scripts/reference-translation-e2e.mjs",
    "test:partners-e2e": "node scripts/partner-translation-e2e.mjs",
    "dev:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:cloudflare": "npm run build:cloudflare && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.113.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
